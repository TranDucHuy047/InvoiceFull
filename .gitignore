# ==========================================
# Root .gitignore for Invoice Monorepo
# ==========================================

# --- Hệ điều hành & IDE ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# --- Môi trường bảo mật & cấu hình nhạy cảm ---
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# --- Sao lưu & Git backup ---
*.git_backup/
*.bak

# --- Cơ sở dữ liệu SQLite / Local DB ---
*.db
*.sqlite
*.sqlite3
backups/

# --- Python / Backend (invoice-backend) ---
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.log

# --- Node.js / Frontend (invoice-admin-web & invoice-web) ---
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# --- Flutter / Dart (invoice_qa_app_Frontend) ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
*.pub
*.apk
*.aab
**/ephemeral/
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
ios/Pods/
android/.gradle/
android/captures/
android/local.properties
**/android/local.properties
**/android/.gradle/
