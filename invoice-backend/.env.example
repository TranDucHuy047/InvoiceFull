# Cấu hình API Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Đường dẫn Tesseract OCR (Windows: C:\Program Files\Tesseract-OCR\tesseract.exe hoặc Linux: tesseract)
TESSERACT_CMD=tesseract

# Cấu hình gửi mail OTP / thông báo (Gmail App Password)
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
